services:
    _defaults:
        public: true
        autowire: false
        autoconfigure: false

    plunkconnect.command.outbox_process:
        class: PlunkConnect\Command\ProcessOutboxCommand
        tags: ['console.command']

    plunkconnect.command.subscribers_backfill:
        class: PlunkConnect\Command\BackfillSubscribersCommand
        tags: ['console.command']

    plunkconnect.command.orders_backfill:
        class: PlunkConnect\Command\BackfillOrdersCommand
        tags: ['console.command']

    plunkconnect.command.subscribers_reconcile:
        class: PlunkConnect\Command\ReconcileSubscribersCommand
        tags: ['console.command']

    plunkconnect.command.coupons_cleanup:
        class: PlunkConnect\Command\CleanupCouponsCommand
        tags: ['console.command']

    plunkconnect.command.catalog_sync:
        class: PlunkConnect\Command\SyncCatalogCommand
        tags: ['console.command']

    plunkconnect.command.winback:
        class: PlunkConnect\Command\WinbackCommand
        tags: ['console.command']

    plunkconnect.command.newsletter_new_products:
        class: PlunkConnect\Command\NewProductsCommand
        tags: ['console.command']
