parameters:
    level: 6
    paths:
        - src
        - controllers
        - plunkconnect.php
        - sql
    excludePaths:
        - vendor/*
        - tests/*
    # PrestaShop core classes (Context, Db, Configuration, Module, ...)
    # come from the shop runtime; phpstan runs with prestashop/php-dev-tools
    # inside a shop checkout where core is autoloadable.
    checkMissingCallableSignature: false
    bootstrapFiles:
        - tests/stubs.php
    ignoreErrors:
        # Stub artefacts: stub properties are declared non-nullable while the
        # real PrestaShop runtime can return null/false.
        - '#on left side of \?\? is not nullable#'
        - '#is always true#'
        # Level-6 iterable-type requirements; tighten incrementally later.
        - '#no value type specified in iterable type#'
