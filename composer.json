{
    "name": "moonia33/plunkconnect",
    "description": "PrestaShop module connecting the shop to a self-hosted Plunk instance (newsletter sync, behavioural events, catalog feed, coupons).",
    "type": "prestashop-module",
    "license": "proprietary",
    "authors": [
        {
            "name": "TV Parkas",
            "email": "dev@tvparkas.lt"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^4.3",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "PlunkConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlunkConnect\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    }
}
